#!/usr/bin/env sh
# ocr — one-shot wrapper around ocrd + ocrd-client for use in scripts.
#
# Starts the ocrd daemon on first use (and leaves it running, warm, for the
# next call), then forwards every argument to ocrd-client.
#
#   ocr --file shot.png                        # text to stdout
#   grim -g "$(slurp)" - | ocr --lang latin | wl-copy
#   ocr --file page.png --json | jq -r '.lines[].text'
#
# Env overrides:
#   OCRD_SOCKET   socket path         (default: $XDG_RUNTIME_DIR/ocrd.sock)
#   OCRD_ACCEL    auto|cpu|cuda|openvino|webgpu|directml   (default: auto)
#   OCRD_BIN      path to ocrd        (default: found on PATH)
#   OCRD_CLIENT   path to ocrd-client (default: found on PATH)

set -eu

# Fallback mirrors ocr-proto::default_socket_path: a per-user subdirectory,
# never a bare file in a shared /tmp. The daemon locks it down (0700 dir,
# 0600 socket).
if [ -n "${OCRD_SOCKET:-}" ]; then
    sock="$OCRD_SOCKET"
elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    sock="$XDG_RUNTIME_DIR/ocrd.sock"
else
    sock="${TMPDIR:-/tmp}/ocrd-$(id -un)/ocrd.sock"
fi
accel="${OCRD_ACCEL:-auto}"
ocrd_bin="${OCRD_BIN:-ocrd}"
client_bin="${OCRD_CLIENT:-ocrd-client}"

if ! "$client_bin" --socket "$sock" --ping >/dev/null 2>&1; then
    # Remove only a stale socket we own; the daemon re-checks this too.
    if [ -e "$sock" ] && [ -O "$sock" ]; then
        rm -f "$sock" 2>/dev/null || true
    fi
    setsid "$ocrd_bin" --accel "$accel" --socket "$sock" >/dev/null 2>&1 &
    i=0
    until "$client_bin" --socket "$sock" --ping >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -gt 300 ] && { echo "ocr: ocrd did not come up within 30s" >&2; exit 1; }
        sleep 0.1
    done
fi

exec "$client_bin" --socket "$sock" "$@"
