# systemd --user unit for the resident OCR daemon.
#
#   mkdir -p ~/.config/systemd/user
#   cp contrib/ocrd.service ~/.config/systemd/user/
#   cargo install --path crates/ocrd          # puts `ocrd` on PATH
#   systemctl --user daemon-reload
#   systemctl --user enable --now ocrd
#
# Logs:  journalctl --user -u ocrd -f

[Unit]
Description=Resident multilingual OCR daemon (PP-OCRv5 via oar-ocr)
Documentation=https://github.com/BGLuis/ocr#readme
After=graphical-session.target

[Service]
Type=simple
# --accel auto probes CUDA and falls back to CPU with a logged reason.
#   cpu                  pin CPU
#   cuda                 require NVIDIA (needs --features cuda + cuDNN 9)
#   openvino             require Intel GPU (needs --features openvino + system ORT)
#   webgpu               require AMD/Linux (needs a source ORT with Dawn)
#   directml             require Windows GPU
ExecStart=%h/.cargo/bin/ocrd --accel auto
Environment=RUST_LOG=ocrd=info,ocr_core=info
# Model cache location (oar-ocr default is ~/.oar).
Environment=OAR_HOME=%h/.oar
Restart=on-failure
RestartSec=2
# The daemon removes its socket on stop / SIGTERM / SIGINT.

[Install]
WantedBy=graphical-session.target
